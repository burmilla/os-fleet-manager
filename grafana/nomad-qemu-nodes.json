{
  "__inputs": [],
  "uid": "burfleet-nomad-qemu-nodes",
  "title": "Nomad QEMU nodes",
  "description": "BurFleet view of Nomad QEMU nodes: OS, QEMU and Nomad versions, upgrade rollout, Nomad node status and maintenance locks.",
  "tags": [
    "burmilla",
    "fleet",
    "nomad"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Group",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "query": {
          "query": "label_values(burmilla_fleet_server_desired_info{node_type=\"nomad-qemu-node\"}, swarm)",
          "refId": "v"
        },
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Environment",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "query": {
          "query": "label_values(burmilla_fleet_server_desired_info{node_type=\"nomad-qemu-node\",swarm=~\"$group\"}, environment)",
          "refId": "v"
        },
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Nodes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(burmilla_fleet_server_desired_info{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Up to date",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(burmilla_fleet_server_up_to_date{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Pending maintenance",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(burmilla_fleet_server_up_to_date{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"} == 0) or vector(0)",
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Not reporting (15m)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((time() - burmilla_fleet_server_last_report_timestamp_seconds{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"}) > 900) or vector(0)",
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Not schedulable",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(burmilla_fleet_server_nomad_node{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"} unless burmilla_fleet_server_nomad_node{status=\"ready\",eligibility=\"eligible\",drain=\"false\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "description": "Nomad nodes which are down, ineligible or draining, e.g. while in maintenance.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Running allocations",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(burmilla_fleet_server_nomad_allocations{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "description": "Running Nomad allocations (VMs) on the nodes.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "title": "OS versions",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (os_version) (burmilla_fleet_server_info{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"})",
          "legendFormat": "{{os_version}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "QEMU versions",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (qemu_version) (burmilla_fleet_server_info{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"})",
          "legendFormat": "{{qemu_version}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Nomad versions",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (nomad_version) (burmilla_fleet_server_info{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"})",
          "legendFormat": "{{nomad_version}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 10,
      "title": "Nodes",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (hostname, swarm, environment, os_version, qemu_version, nomad_version) (burmilla_fleet_server_info{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"})",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (hostname, target_os_version, upgrade_policy) (label_replace(burmilla_fleet_server_desired_info{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"}, \"target_os_version\", \"$1\", \"os_version\", \"(.*)\"))",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (hostname) (burmilla_fleet_server_up_to_date{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"})",
          "refId": "C",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (hostname, status, eligibility, drain) (burmilla_fleet_server_nomad_node{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"})",
          "refId": "D",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (hostname) (burmilla_fleet_server_nomad_allocations{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"})",
          "refId": "E",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (hostname) (time() - burmilla_fleet_server_last_report_timestamp_seconds{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"})",
          "refId": "F",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (hostname) (time() - burmilla_fleet_server_boot_timestamp_seconds{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"})",
          "refId": "G",
          "format": "table",
          "instant": true
        }
      ],
      "description": "Reported versions, target OS version and Nomad node status. Kernel versions are on the BurFleet server dashboard. Nomad status is empty when fleet-client has no Nomad token.",
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Node",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 70
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Policy"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Up to date"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "QEMU"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Nomad"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 75
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Draining"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Allocations"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last report"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Up to date"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "yes",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last report"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Eligibility"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "eligible": {
                        "color": "green",
                        "index": 0
                      },
                      "ineligible": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Nomad status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ready": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".+",
                      "result": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "hostname",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time": true,
              "Value #A": true,
              "Value #B": true,
              "Value #D": true
            },
            "indexByName": {
              "hostname": 0,
              "swarm": 1,
              "environment": 2,
              "os_version": 3,
              "target_os_version": 4,
              "upgrade_policy": 5,
              "Value #C": 6,
              "qemu_version": 7,
              "nomad_version": 8,
              "status": 9,
              "eligibility": 10,
              "drain": 11,
              "Value #E": 12,
              "Value #F": 13,
              "Value #G": 14
            },
            "renameByName": {
              "hostname": "Node",
              "swarm": "Group",
              "environment": "Environment",
              "os_version": "OS",
              "target_os_version": "Target OS",
              "upgrade_policy": "Policy",
              "Value #C": "Up to date",
              "qemu_version": "QEMU",
              "nomad_version": "Nomad",
              "status": "Nomad status",
              "eligibility": "Eligibility",
              "drain": "Draining",
              "Value #E": "Allocations",
              "Value #F": "Last report",
              "Value #G": "Uptime"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "OS version rollout",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (os_version) (burmilla_fleet_server_info{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"})",
          "legendFormat": "{{os_version}}",
          "refId": "A"
        }
      ],
      "description": "Nodes per OS version over time.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "Running allocations per node",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (hostname) (burmilla_fleet_server_nomad_allocations{node_type=\"nomad-qemu-node\",swarm=~\"$group\",environment=~\"$environment\"})",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "description": "Allocations move away while a node is drained for maintenance.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
